<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  System LaunchDaemon for cloudflared tunnel watchdog.

  Runs as root every 2 minutes, probes the public URL, kickstarts
  cloudflared if N consecutive probes fail. See tunnel-watchdog.sh for
  the detection rationale.

  This is a TEMPLATE — TWO placeholders must be replaced before install:
    {{PROJECT_ROOT}}  absolute path to volunteer-tracker checkout on host
    {{NTFY_TOPIC}}    ntfy topic for notifications (set empty to disable)

  Why a system LaunchDaemon (and not a user LaunchAgent)?
    `launchctl kickstart system/com.cloudflare.cloudflared` requires root,
    so the watchdog itself must run as root. Putting the plist in
    /Library/LaunchDaemons accomplishes this.

  Install (run on Mac mini, requires sudo):

    cd /Users/zsy666/srv/volunteer-tracker
    sudo sed -e "s|{{PROJECT_ROOT}}|$(pwd)|g" \
             -e "s|{{NTFY_TOPIC}}|vt-sandbox-circleooneblood|g" \
      scripts/deploy/com.volunteer-tracker.tunnel-watchdog.plist.template \
      | sudo tee /Library/LaunchDaemons/com.volunteer-tracker.tunnel-watchdog.plist > /dev/null
    sudo chown root:wheel /Library/LaunchDaemons/com.volunteer-tracker.tunnel-watchdog.plist
    sudo chmod 644 /Library/LaunchDaemons/com.volunteer-tracker.tunnel-watchdog.plist
    sudo launchctl bootstrap system /Library/LaunchDaemons/com.volunteer-tracker.tunnel-watchdog.plist

  Verify (after install — should fire immediately due to RunAtLoad):
    sudo launchctl list | grep volunteer-tracker.tunnel-watchdog
    tail -f /Library/Logs/volunteer-tracker-tunnel-watchdog.log

  Uninstall:
    sudo launchctl bootout system/com.volunteer-tracker.tunnel-watchdog
    sudo rm /Library/LaunchDaemons/com.volunteer-tracker.tunnel-watchdog.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.volunteer-tracker.tunnel-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>{{PROJECT_ROOT}}/scripts/deploy/tunnel-watchdog.sh</string>
  </array>

  <!-- Run every 2 minutes. Worst-case detection latency = 2 * threshold = 4 min. -->
  <key>StartInterval</key>
  <integer>120</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- Re-run if the script crashes, but throttle to avoid tight loops. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Library/Logs/volunteer-tracker-tunnel-watchdog.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Library/Logs/volunteer-tracker-tunnel-watchdog.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>NTFY_SERVER</key>
    <string>https://ntfy.sh</string>
    <key>NTFY_TOPIC</key>
    <string>{{NTFY_TOPIC}}</string>
  </dict>
</dict>
</plist>
