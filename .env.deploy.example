# Template for docker-compose.deploy.yml. Copy to .env.deploy and fill in.
# .env.deploy is gitignored (or should be — see .gitignore). NEVER commit
# real secrets.
#
# Generate strong values:
#   openssl rand -hex 32   # for POSTGRES_PASSWORD and JWT_SECRET

# --- Database ---
POSTGRES_PASSWORD=replace-me-with-openssl-rand-hex-32

# --- Auth ---
JWT_SECRET=replace-me-with-openssl-rand-hex-32
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# --- Initial admin (used only on first boot, when the DB has no admin) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-8-chars
BOOTSTRAP_ADMIN_NAME=Admin
