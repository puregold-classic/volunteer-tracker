// Prisma schema v2.1 — Volunteer Tracker
//
// Key changes from v1 (see docs/archive/ for history):
// - Department + ServiceItem replace ServiceType enum (10 departments, ~40 items)
// - NonProjectService → ProjectSupport (rename + status state machine)
// - Self-managed records + proxy submission with owner confirmation
// - Real foreign keys everywhere; Account ↔ Volunteer enforced 1:1 via FK + CHECK
// - ServiceApplication / ApplicationType / ApplicationStatus / ReviewResult removed
//   (审核流简化：自管 + DB 约束防重 + 表单约束防错)
// - Volunteer.role / volunteerName 冗余 / NonProjectService.auditHistory removed
// - Volunteer.volunteerId → volunteerCode (避免与 Account.volunteerId FK 字面冲突)
// - SystemSettings 单行表存全局月结锁定日期
// - nonProjectHours / nonProjectCount 累加器删除，改为按需 SQL aggregation
//
// Manual SQL patches applied in the schema_v2_1 migration:
// - CHECK constraint: accounts.role = 'admin' OR accounts.volunteer_id IS NOT NULL
// - Partial unique index on project_supports for dedup (status='ACTIVE' only)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  user
  b_admin
  a_admin
  admin
}

enum VolunteerStatus {
  ACTIVE   @map("在职")
  INACTIVE @map("不在职")

  @@map("VolunteerStatus")
}

enum Region {
  MAINLAND  @map("中国大陆")
  TAIWAN    @map("中国台湾")
  SOUTHEAST @map("东南亚")
  USA       @map("美国")
  EUROPE    @map("欧洲")
  OTHER     @map("其他")

  @@map("Region")
}

enum ActivityLevel {
  HIGH   @map("高")
  MEDIUM @map("中")
  LOW    @map("低")

  @@map("ActivityLevel")
}

enum ProjectSupportStatus {
  ACTIVE                // 已生效（自提交直接到这里；代提交 confirm 后到这里）
  PENDING_CONFIRMATION  // 代提交，等 owner 确认
  REJECTED_BY_OWNER     // owner 拒绝（保留行做审计）
  DELETED               // 软删（替代旧 isActive=false）

  @@map("ProjectSupportStatus")
}

enum AuditTargetType {
  ProjectSupport
  Volunteer
  Account
  SystemSettings
  Project

  @@map("AuditTargetType")
}

enum AuditAction {
  support_create
  support_update
  support_delete
  support_confirm
  support_reject
  volunteer_create
  volunteer_update
  volunteer_deactivate
  account_create
  account_update
  month_lock
  system_cleanup
  seed_import
  project_create
  project_update
  project_delete
  project_attendance_batch
  project_link_support
}

// Classifies a ServiceItem into the v3 三大板块 buckets. Category is assigned
// per ServiceItem rather than per Department because a few departments (TECH,
// CARE) span multiple categories via their individual items (e.g. TECH has
// both 技术培训 which is PROJECT_TRAINING and 计时/播放 which are PROJECT_SUPPORT).
// TRAINING_ATTENDANCE records are only produced via project-level batch entry
// (wave 2); individual submission is service-layer blocked.
enum ServiceCategory {
  PROJECT_MGMT
  PROJECT_TRAINING
  PROJECT_SUPPORT
  TRAINING_ATTENDANCE

  @@map("ServiceCategory")
}

// ─── Reference data ───────────────────────────────────────────────────────────

model Department {
  // Human-readable code as PK (e.g. "BY_PROJECT") for stable references in code/seed
  id           String   @id
  name         String   @unique
  displayOrder Int      @unique
  createdAt    DateTime @default(now())

  volunteers   Volunteer[]
  serviceItems ServiceItem[]
  projects     Project[]

  @@map("departments")
}

model ServiceItem {
  id           String          @id @default(cuid())
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id])
  name         String
  // Category drives the 三大板块 tabbing in the submission UI and the ledger.
  // TRAINING_ATTENDANCE items are blocked from individual submission by
  // ProjectSupportService.create; they are populated via batch-entry only.
  category     ServiceCategory @default(PROJECT_SUPPORT)
  displayOrder Int
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  projectSupports ProjectSupport[]

  @@unique([departmentId, name])
  @@index([departmentId, displayOrder])
  @@index([category])
  @@map("service_items")
}

// ─── Identity ─────────────────────────────────────────────────────────────────

model Account {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(user)
  // 1:1 with Volunteer; admin role is the only one allowed to have NULL.
  // CHECK constraint enforced in migration SQL.
  volunteerId  String?    @unique
  volunteer    Volunteer? @relation(fields: [volunteerId], references: [id])
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  // Any JWT with iat < tokenValidAfter is rejected. Updated on logout and
  // password change so those actions effectively revoke existing tokens
  // without needing a blacklist table.
  tokenValidAfter DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role, isActive])
  @@map("accounts")
}

model Volunteer {
  id              String          @id @default(cuid())
  // Domain code like "PG-0001". Renamed from v1's volunteerId to avoid
  // ambiguity with Account.volunteerId (which is the FK to Volunteer.id).
  volunteerCode   String          @unique
  chineseName     String
  englishName     String
  avatar          String          @default("https://ui-avatars.com/api/?name=Unknown&background=random")
  status          VolunteerStatus @default(ACTIVE)
  region          Region
  province        String?
  subRegion       String?
  departmentId    String
  department      Department      @relation(fields: [departmentId], references: [id])
  activityLevel   ActivityLevel   @default(MEDIUM)
  email           String?
  phone           String?
  joinDate        DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  account            Account?
  ownedSupports      ProjectSupport[] @relation("OwnedSupports")
  submittedSupports  ProjectSupport[] @relation("SubmittedSupports")
  createdProjects    Project[]        @relation("CreatedProjects")

  @@index([status])
  @@index([region])
  @@index([activityLevel])
  @@index([departmentId])
  @@map("volunteers")
}

// ─── Project support records (renamed from NonProjectService) ─────────────────

model ProjectSupport {
  id              String               @id @default(cuid())
  // Human-readable code like "PS-0001"
  supportId       String               @unique
  // Owner of the record (whose service hours this counts toward)
  volunteerId     String
  volunteer       Volunteer            @relation("OwnedSupports", fields: [volunteerId], references: [id])
  // Submitter (may be the same as owner for self-submit, or different for proxy submit)
  submittedById   String
  submittedBy     Volunteer            @relation("SubmittedSupports", fields: [submittedById], references: [id])
  serviceItemId   String
  serviceItem     ServiceItem          @relation(fields: [serviceItemId], references: [id])
  // Optional link to a Project (session). Set automatically when a record is
  // created via project-level batch entry, and can be set later by admin/self
  // to tag an existing support to a specific session.
  projectId       String?
  project         Project?             @relation(fields: [projectId], references: [id])
  serviceDate     DateTime
  duration        Float
  description     String
  status          ProjectSupportStatus @default(ACTIVE)
  // Set when owner confirms a proxy submission
  confirmedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([volunteerId, serviceDate(sort: Desc)])
  @@index([submittedById, status])
  @@index([serviceItemId])
  @@index([status])
  @@index([projectId])
  // Partial unique index for dedup added in migration SQL:
  //   UNIQUE (volunteer_id, service_date, service_item_id, duration, description)
  //   WHERE status = 'ACTIVE'
  @@map("project_supports")
}

// ─── Project (v3 wave 2) ──────────────────────────────────────────────────────
//
// A Project is a specific session/instance — e.g. "2026-04 笔译培训 第 12 期".
// It groups ProjectSupport records that belong to the same real-world event.
//
// The 大类 is Project.category (reuses ServiceCategory). At MVP only
// TRAINING_ATTENDANCE is accepted by the service layer — batch-attendance
// entry populates ProjectSupport rows with projectId set and duration
// snapshotted from Project.sessionDuration. Duration on TRAINING_ATTENDANCE
// projects is immutable after creation (ledger integrity).
//
// `attributes` is JSONB for flexible tagging: { language, level, noteType, ... }
// — see v3-plan.md for the planned tag splits (XZT 中英笔记 / 培训内容级别).

model Project {
  id              String          @id @default(cuid())
  projectCode     String          @unique      // human-readable, e.g. "PROJ-0001"
  name            String
  category        ServiceCategory              // 大类, MVP: TRAINING_ATTENDANCE only
  departmentId    String
  department      Department      @relation(fields: [departmentId], references: [id])
  sessionDate     DateTime
  sessionDuration Float?                       // session length in hours; required for TRAINING_ATTENDANCE
  attributes      Json            @default("{}")
  createdById     String
  createdBy       Volunteer       @relation("CreatedProjects", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  projectSupports ProjectSupport[]

  @@index([category])
  @@index([departmentId])
  @@index([sessionDate(sort: Desc)])
  @@map("projects")
}

// ─── Global settings ──────────────────────────────────────────────────────────

model SystemSettings {
  // Singleton table — application code only ever reads/writes id=1
  id           Int       @id @default(1)
  // Records with serviceDate < lockedBefore are immutable to non-admin users.
  // Null means nothing is locked.
  lockedBefore DateTime?
  updatedAt    DateTime  @updatedAt
  updatedById  String?

  @@map("system_settings")
}

// ─── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id            String          @id @default(cuid())
  auditId       String          @unique
  targetType    AuditTargetType
  targetId      String
  action        AuditAction
  // {field-specific details for the action} — JSONB snapshot
  actionDetails Json
  modifiedId    String?
  // Array of {field, from, to} — JSONB snapshot
  changes       Json            @default("[]")
  // {id, name, role} of the user who performed the action — JSONB snapshot
  operator      Json
  // {id, name, role} of the originating submitter (meaningful for support_confirm
  // where operator=owner and submitter=proxy)
  submitter     Json
  timestamp     DateTime        @default(now())

  @@index([timestamp(sort: Desc)])
  @@index([targetId])
  @@index([modifiedId])
  @@map("audit_logs")
}
