// Prisma schema v2.1 — Volunteer Tracker
//
// Key changes from v1 (see docs/archive/ for history):
// - Department + ServiceItem replace ServiceType enum (10 departments, ~40 items)
// - NonProjectService → ProjectSupport (rename + status state machine)
// - Self-managed records + proxy submission with owner confirmation
// - Real foreign keys everywhere; Account ↔ Volunteer enforced 1:1 via FK + CHECK
// - ServiceApplication / ApplicationType / ApplicationStatus / ReviewResult removed
//   (审核流简化：自管 + DB 约束防重 + 表单约束防错)
// - Volunteer.role / volunteerName 冗余 / NonProjectService.auditHistory removed
// - Volunteer.volunteerId → volunteerCode (避免与 Account.volunteerId FK 字面冲突)
// - SystemSettings 单行表存全局月结锁定日期
// - nonProjectHours / nonProjectCount 累加器删除，改为按需 SQL aggregation
//
// Manual SQL patches applied in the schema_v2_1 migration:
// - CHECK constraint: accounts.role = 'admin' OR accounts.volunteer_id IS NOT NULL
// - Partial unique index on project_supports for dedup (status='ACTIVE' only)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  user
  b_admin
  a_admin
  admin
}

enum VolunteerStatus {
  ACTIVE   @map("在职")
  INACTIVE @map("不在职")

  @@map("VolunteerStatus")
}

enum Region {
  MAINLAND  @map("中国大陆")
  TAIWAN    @map("中国台湾")
  SOUTHEAST @map("东南亚")
  USA       @map("美国")
  EUROPE    @map("欧洲")
  OTHER     @map("其他")

  @@map("Region")
}

enum ActivityLevel {
  HIGH   @map("高")
  MEDIUM @map("中")
  LOW    @map("低")

  @@map("ActivityLevel")
}

enum ProjectSupportStatus {
  ACTIVE                // 已生效（自提交直接到这里；代提交 confirm 后到这里）
  PENDING_CONFIRMATION  // 代提交，等 owner 确认
  REJECTED_BY_OWNER     // owner 拒绝（保留行做审计）
  DELETED               // 软删（替代旧 isActive=false）

  @@map("ProjectSupportStatus")
}

enum AuditTargetType {
  ProjectSupport
  Volunteer
  Account
  SystemSettings
  Project
  TagGroup
  Tag

  @@map("AuditTargetType")
}

enum AuditAction {
  support_create
  support_update
  support_delete
  support_confirm
  support_reject
  volunteer_create
  volunteer_update
  volunteer_deactivate
  account_create
  account_update
  month_lock
  system_cleanup
  seed_import
  // v2: Project actions. Deprecated in v3.2 (Project 概念被 Tag/TagGroup 替代);
  // old audit rows still carry these for historical accuracy, do not emit new ones.
  project_create
  project_update
  project_delete
  project_attendance_batch
  project_link_support
  list_create
  list_update
  list_delete
  list_member_add
  list_member_remove
  // v3.2: Tag system actions
  tag_group_create
  tag_group_update
  tag_group_delete
  tag_create
  tag_update
  tag_delete
  tag_attach
  tag_detach
  support_batch_create
  support_batch_update
  support_batch_delete
  support_batch_attach
  support_batch_detach
  // v3.2: account-self actions
  account_password_change
  account_password_reset
  account_avatar_update
}

// v3.2 tag system — 3 orthogonal config axes on the group level.
//
// selectionMode: UI picker behavior inside submit form (radio vs checkbox)
// opMode:         which batch operations the group exposes
// openness:       whether tag values are fixed (closed) or admin can add at
//                 runtime (open)

enum TagSelectionMode {
  single
  multi

  @@map("TagSelectionMode")
}

enum TagOpMode {
  managed     // allows batch create/update/delete of ProjectSupport via this group
  tag_only    // only attach / detach — tag values are pure labels

  @@map("TagOpMode")
}

enum TagOpenness {
  closed      // tag values fixed by admin, cannot be added at submit time
  open        // authorized user can add new tag values on the fly

  @@map("TagOpenness")
}

// Classifies a ServiceItem into the v3 三大板块 buckets. Category is assigned
// per ServiceItem rather than per Department because a few departments (TECH,
// CARE) span multiple categories via their individual items (e.g. TECH has
// both 技术培训 which is PROJECT_TRAINING and 计时/播放 which are PROJECT_SUPPORT).
// TRAINING_ATTENDANCE records are only produced via project-level batch entry
// (wave 2); individual submission is service-layer blocked.
enum ServiceCategory {
  PROJECT_MGMT
  PROJECT_TRAINING
  PROJECT_SUPPORT
  TRAINING_ATTENDANCE

  @@map("ServiceCategory")
}

// ─── Reference data ───────────────────────────────────────────────────────────

model Department {
  // Human-readable code as PK (e.g. "BY_PROJECT") for stable references in code/seed
  id           String   @id
  name         String   @unique
  displayOrder Int      @unique
  createdAt    DateTime @default(now())

  volunteers   Volunteer[]
  serviceItems ServiceItem[]

  @@map("departments")
}

model ServiceItem {
  id           String          @id @default(cuid())
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id])
  name         String
  // Category drives the 三大板块 tabbing in the submission UI and the ledger.
  // TRAINING_ATTENDANCE items are blocked from individual submission by
  // ProjectSupportService.create; they are populated via batch-entry only.
  category     ServiceCategory @default(PROJECT_SUPPORT)
  displayOrder Int
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())

  projectSupports ProjectSupport[]

  @@unique([departmentId, name])
  @@index([departmentId, displayOrder])
  @@index([category])
  @@map("service_items")
}

// ─── Identity ─────────────────────────────────────────────────────────────────

model Account {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(user)
  // 1:1 with Volunteer; admin role is the only one allowed to have NULL.
  // CHECK constraint enforced in migration SQL.
  volunteerId  String?    @unique
  volunteer    Volunteer? @relation(fields: [volunteerId], references: [id])
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  // Any JWT with iat < tokenValidAfter is rejected. Updated on logout and
  // password change so those actions effectively revoke existing tokens
  // without needing a blacklist table.
  tokenValidAfter DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([role, isActive])
  @@map("accounts")
}

model Volunteer {
  id              String          @id @default(cuid())
  // Domain code like "PG-0001". Renamed from v1's volunteerId to avoid
  // ambiguity with Account.volunteerId (which is the FK to Volunteer.id).
  volunteerCode   String          @unique
  chineseName     String
  englishName     String
  avatar          String          @default("https://ui-avatars.com/api/?name=Unknown&background=random")
  status          VolunteerStatus @default(ACTIVE)
  region          Region
  province        String?
  subRegion       String?
  departmentId    String
  department      Department      @relation(fields: [departmentId], references: [id])
  activityLevel   ActivityLevel   @default(MEDIUM)
  email           String?
  // v3.3: phone is also a login identifier, so non-null values must be unique.
  // Normalized to digits-only canonical form by AccountService / VolunteerService
  // on write. Empty strings are normalized to NULL so they don't collide.
  phone           String?         @unique
  joinDate        DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  account            Account?
  ownedSupports      ProjectSupport[] @relation("OwnedSupports")
  submittedSupports  ProjectSupport[] @relation("SubmittedSupports")
  // v3 wave-3: lists this volunteer owns, and lists that include this volunteer
  ownedLists         VolunteerList[]       @relation("ListOwner")
  listMemberships    VolunteerListMember[] @relation("ListMember")
  // v3.2: tag system authorship + attachment attribution
  createdTagGroups   TagGroup[]            @relation("CreatedTagGroups")
  createdTags        Tag[]                 @relation("CreatedTags")
  tagAttachments     TagAttachment[]       @relation("TagAttachments")

  @@index([status])
  @@index([region])
  @@index([activityLevel])
  @@index([departmentId])
  @@map("volunteers")
}

// ─── Project support records (renamed from NonProjectService) ─────────────────

model ProjectSupport {
  id              String               @id @default(cuid())
  // Human-readable code like "PS-0001"
  supportId       String               @unique
  // Owner of the record (whose service hours this counts toward)
  volunteerId     String
  volunteer       Volunteer            @relation("OwnedSupports", fields: [volunteerId], references: [id])
  // Submitter (may be the same as owner for self-submit, or different for proxy submit)
  submittedById   String
  submittedBy     Volunteer            @relation("SubmittedSupports", fields: [submittedById], references: [id])
  serviceItemId   String
  serviceItem     ServiceItem          @relation(fields: [serviceItemId], references: [id])
  // v3.2 tag attachments (M:N to Tag via TagAttachment). Replaces the old
  // single projectId FK — dropped in 20260420 migration.
  tagAttachments  TagAttachment[]
  serviceDate     DateTime
  duration        Float
  description     String
  status          ProjectSupportStatus @default(ACTIVE)
  // Set when owner confirms a proxy submission
  confirmedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([volunteerId, serviceDate(sort: Desc)])
  @@index([submittedById, status])
  @@index([serviceItemId])
  @@index([status])
  // Partial unique index for dedup added in migration SQL:
  //   UNIQUE (volunteer_id, service_date, service_item_id, duration, description)
  //   WHERE status = 'ACTIVE'
  @@map("project_supports")
}

// ─── Volunteer lists (v3 wave 3) ──────────────────────────────────────────────
//
// Private per-volunteer tracking lists. Primary use case: admins / 部长
// keeping an eye on specific volunteers ("我的关注"), and regular volunteers
// remembering friends they commonly代提交 for. MVP only supports a single
// default list per owner (lazy-created on first follow), but the schema
// is ready for multi-list when user asks for it.
//
// Admin accounts without a volunteer binding (pure system admin, v2.1 only
// role allowed to have volunteerId=null) do not own lists — they use the
// ledger instead. All other roles have a Volunteer FK.

model VolunteerList {
  id        String                @id @default(cuid())
  ownerId   String
  owner     Volunteer             @relation("ListOwner", fields: [ownerId], references: [id])
  name      String                // "我的关注", "翻译同事", …
  isDefault Boolean               @default(false)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  members   VolunteerListMember[]

  @@unique([ownerId, name])
  @@index([ownerId])
  @@map("volunteer_lists")
}

model VolunteerListMember {
  id          String        @id @default(cuid())
  listId      String
  list        VolunteerList @relation(fields: [listId], references: [id], onDelete: Cascade)
  volunteerId String
  volunteer   Volunteer     @relation("ListMember", fields: [volunteerId], references: [id])
  note        String?
  addedAt     DateTime      @default(now())

  @@unique([listId, volunteerId])
  @@index([volunteerId])
  @@map("volunteer_list_members")
}

// ─── Tag system (v3.2) ────────────────────────────────────────────────────────
//
// Replaces the Project concept. A tag is a label that can be attached to
// project_supports (M:N). Tag values are grouped; each group declares the
// structure & rules that apply to its tags.
//
// Design axes on the group level (all orthogonal):
// - selectionMode: radio (single) vs checkbox (multi) in submit UI
// - opMode:        managed (enables batch create/update/delete) vs tag_only
// - openness:      closed (fixed values) vs open (runtime-addable)
//
// Examples:
//   项目方       = single + tag_only  + closed  + required
//   笔译岗位     = single + tag_only  + closed  + required
//   Session 容器 = multi  + managed   + open    + not-required
//   自由分类     = multi  + tag_only  + open    + not-required
//
// boundServiceItemIds: when a submit form picks one of these service items,
// the UI prompts the user for a tag from this group. Empty array = group
// always shown / never auto-prompted (session tags attach manually).

model TagGroup {
  id                   String            @id @default(cuid())
  name                 String            @unique
  description          String?
  boundServiceItemIds  String[]
  selectionMode        TagSelectionMode  @default(single)
  opMode               TagOpMode         @default(tag_only)
  openness             TagOpenness       @default(closed)
  required             Boolean           @default(false)
  createdById          String
  createdBy            Volunteer         @relation("CreatedTagGroups", fields: [createdById], references: [id])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  tags                 Tag[]

  @@index([createdById])
  @@map("tag_groups")
}

model Tag {
  id           String    @id @default(cuid())
  groupId      String
  group        TagGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String
  createdById  String
  createdBy    Volunteer @relation("CreatedTags", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attachments  TagAttachment[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("tags")
}

model TagAttachment {
  id           String         @id @default(cuid())
  tagId        String
  tag          Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  supportId    String
  support      ProjectSupport @relation(fields: [supportId], references: [id], onDelete: Cascade)
  attachedById String
  attachedBy   Volunteer      @relation("TagAttachments", fields: [attachedById], references: [id])
  attachedAt   DateTime       @default(now())

  @@unique([tagId, supportId])
  @@index([supportId])
  @@index([tagId])
  @@map("tag_attachments")
}

// ─── Global settings ──────────────────────────────────────────────────────────

model SystemSettings {
  // Singleton table — application code only ever reads/writes id=1
  id           Int       @id @default(1)
  // Records with serviceDate < lockedBefore are immutable to non-admin users.
  // Null means nothing is locked.
  lockedBefore DateTime?
  updatedAt    DateTime  @updatedAt
  updatedById  String?

  @@map("system_settings")
}

// ─── Audit log ────────────────────────────────────────────────────────────────

model AuditLog {
  id            String          @id @default(cuid())
  auditId       String          @unique
  targetType    AuditTargetType
  targetId      String
  action        AuditAction
  // {field-specific details for the action} — JSONB snapshot
  actionDetails Json
  modifiedId    String?
  // Array of {field, from, to} — JSONB snapshot
  changes       Json            @default("[]")
  // {id, name, role} of the user who performed the action — JSONB snapshot
  operator      Json
  // {id, name, role} of the originating submitter (meaningful for support_confirm
  // where operator=owner and submitter=proxy)
  submitter     Json
  timestamp     DateTime        @default(now())

  @@index([timestamp(sort: Desc)])
  @@index([targetId])
  @@index([modifiedId])
  @@map("audit_logs")
}
