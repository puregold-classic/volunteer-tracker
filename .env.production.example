NODE_ENV=production
PORT=5000

# MongoDB Atlas连接字符串
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/volunteer_tracker?retryWrites=true&w=majority

# JWT密钥（使用openssl生成）
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# CORS设置
CORS_ORIGIN=*
# 生产环境建议设置为具体域名：https://yourdomain.com

# 可选：其他配置
LOG_LEVEL=info
API_RATE_LIMIT=100
REQUEST_TIMEOUT=30000